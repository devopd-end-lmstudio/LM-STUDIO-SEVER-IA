library(DBI)
library(RSQLite)

db_path <- "pessoas.sqlite"

con <- dbConnect(SQLite(), db_path)

dbExecute(con, "
  CREATE TABLE IF NOT EXISTS pessoas (
    id INTEGER PRIMARY KEY,
    nome TEXT NOT NULL,
    email TEXT NOT NULL UNIQUE
  )
")

inserir_pessoa <- function(id, nome, email) {
  dbExecute(
    con,
    "INSERT INTO pessoas (id, nome, email) VALUES (?, ?, ?)",
    params = list(id, nome, email)
  )
}

# Exemplos de uso:
# inserir_pessoa(1, "Ana Silva", "ana@email.com")
# inserir_pessoa(2, "Joao Souza", "joao@email.com")
#
# Ver os dados salvos:
# dbReadTable(con, "pessoas")

message("Banco criado em: ", normalizePath(db_path, mustWork = FALSE))
message("Tabela criada: pessoas")

dbDisconnect(con)
